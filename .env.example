# Copy to `.env` (not `.env.local` — the Prisma CLI does not read `.env.local`)
# and fill in from the Supabase dashboard: Connect → ORMs → Prisma.
#
# Two URLs, and getting them the wrong way round is the most common way to break
# this setup:
#
#   DATABASE_URL  Transaction pooler, port 6543. Serverless functions open a
#                 connection per invocation and will exhaust a direct connection.
#                 Needs ?pgbouncer=true so Prisma stops using prepared statements.
#
#   DIRECT_URL    Direct connection, port 5432. Migrations only — `prisma migrate`
#                 cannot run over transaction-mode pooling.
#
# If outbound 6543 is blocked on your network, point both at 5432 locally and
# drop ?pgbouncer=true. The symptoms are distinct: a wrong password is `28P01`,
# a blocked port is `ETIMEDOUT`. Do not rotate credentials at a firewall.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Connections this process may hold. Optional; defaults to 3.
#
# The budget is per *process* and there is more than one process: Next runs
# several render workers, each opening its own pool. Measured against Supabase's
# 15-client session pooler, 6 per process still exhausted it and 2 did not — the
# limit is `workers x max`, not `max`. On the transaction pooler the ceiling is
# much higher, so production can afford more than local development.
# DATABASE_POOL_MAX=3

# Clerk, from the dashboard: Configure → API keys. Development keys are fine
# everywhere this project runs — it has no production instance, by choice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where this app's own sign-in and sign-up pages live. Without these, Clerk
# sends people to its hosted pages instead of the routes in `app/`.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where sign-in lands, which is the claim route — it turns a guest into a
# member. `clerk init` writes these as `/`; they must be `/auth/claim` or a
# signing-in guest keeps their cookie and their work is never attached to the
# account. Check for a duplicate definition if the claim seems not to run: the
# last one in the file wins, which is easy to get wrong by appending.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/claim
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/claim

# Guards /api/cron/prune-guests, which deletes abandoned guest owners. Any long
# random string; Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Unset, the route refuses to run rather than pruning for whoever calls it.
#   openssl rand -base64 32
CRON_SECRET=""
