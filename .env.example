# Copy to `.env` (not `.env.local` — the Prisma CLI does not read `.env.local`)
# and fill in from the Supabase dashboard: Connect → ORMs → Prisma.
#
# Two URLs, and getting them the wrong way round is the most common way to break
# this setup:
#
#   DATABASE_URL  Transaction pooler, port 6543. Serverless functions open a
#                 connection per invocation and will exhaust a direct connection.
#                 Needs ?pgbouncer=true so Prisma stops using prepared statements.
#
#   DIRECT_URL    Direct connection, port 5432. Migrations only — `prisma migrate`
#                 cannot run over transaction-mode pooling.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
